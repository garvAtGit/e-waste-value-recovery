# E-Waste Value Recovery - Supabase Configuration Template
# Copy this file to .env.local for local development. Never commit real secrets.

# 1. Public client configuration (safe for browser exposure via Next.js NEXT_PUBLIC_ prefix)
# Retrieve from Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-public-key

# 2. Privileged Server-side Role Key (STRICTLY SERVER-SIDE ONLY - NEVER expose to browser)
# Used only by administrative scripts or secure server action endpoints to seed or manage records.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-privileged-service-role-key
